# ============================================
# StayOnTrack — Production Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_USER=stayontrack
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=stayontrack

# --- JWT ---
# REQUIRED in production — generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_STRONG_SECRET

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=https://your-domain.com

# --- Email (Resend) ---
# Get your API key at https://resend.com — free tier: 100 emails/day
# If not set, emails are logged to console (dev mode)
RESEND_API_KEY=re_XXXXXXXXX
EMAIL_FROM=StayOnTrack <noreply@your-domain.com>

# --- Next.js ---
# URL for API calls from the browser
NEXT_PUBLIC_API_URL=https://your-domain.com
