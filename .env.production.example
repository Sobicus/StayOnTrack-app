# Database
DB_HOST=db
DB_PORT=5432
DB_USER=stayontrack
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=stayontrack

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS

# CORS
CORS_ORIGIN=https://stayontrack.app

# API URL (used by frontend at build time)
NEXT_PUBLIC_API_URL=https://api.stayontrack.app/api/v1

# Optional: Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=noreply@stayontrack.app

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.stayontrack.app/api/v1/auth/google/callback

# Optional: Telegram
TELEGRAM_BOT_TOKEN=

# Optional: Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:noreply@stayontrack.app
