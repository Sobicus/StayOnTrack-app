# Database
DB_HOST=db
DB_PORT=5432
DB_USER=stayontrack
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=stayontrack

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS

# CORS
CORS_ORIGIN=https://stayontrack.day

# API URL (used by frontend — baked in at BUILD time, not runtime)
NEXT_PUBLIC_API_URL=https://api.stayontrack.day/api/v1

# Frontend URL — used by the API to redirect back after Google OAuth login
NEXT_PUBLIC_APP_URL=https://stayontrack.day

# Optional: Email (Gmail SMTP via nodemailer)
# GMAIL_APP_PASSWORD = 16-char app password from Google Account → Security → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=StayOnTrack <noreply@stayontrack.day>

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.stayontrack.day/api/v1/auth/google/callback

# Optional: Telegram
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Optional: Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:noreply@stayontrack.day
